---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { DEFAULT_LOCALE, LOCALES, switchLocalePath, toLocale, useTranslations } from '../i18n';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang);
const {
	title = `${t('site.name')} — ${t('site.tagline')}`,
	description = t('site.description'),
} = Astro.props;

const absolute = (path: string) => new URL(path, Astro.site).href;
const alternates = LOCALES.map((l) => ({ lang: l, href: absolute(switchLocalePath(Astro.url.pathname, l)) }));
const xDefault = alternates.find((a) => a.lang === DEFAULT_LOCALE)!.href;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#FFFFFF" />
		<link rel="canonical" href={absolute(Astro.url.pathname)} />
		{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
		<link rel="alternate" hreflang="x-default" href={xDefault} />
		<Font cssVariable="--font-sora" preload={[{ weight: '700' }]} />
		<Font cssVariable="--font-inter" preload />
	</head>
	<body>
		<a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>

---
// Layout de las páginas legales escritas en Markdown (src/pages/**/privacy.md, delete-account.md).
// Frontmatter: title, description y, opcionalmente, updated (YYYY-MM).
import { toLocale, useTranslations } from '../i18n';
import BaseLayout from './BaseLayout.astro';

interface Props {
	frontmatter: { title: string; description: string; updated?: string };
}

const { title, description, updated } = Astro.props.frontmatter;
const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang);

const updatedLabel = updated
	? new Date(`${updated}-01T00:00:00Z`).toLocaleDateString(lang, { month: 'long', year: 'numeric', timeZone: 'UTC' })
	: null;
---

<BaseLayout title={`${title} — ${t('site.name')}`} description={description}>
	<article class="container prose">
		<header class="prose__head">
			<h1>{title}</h1>
			{
				updated && (
					<p class="prose__updated">
						{t('legal.updated')}: <time datetime={updated}>{updatedLabel}</time>
					</p>
				)
			}
		</header>
		<slot />
	</article>
</BaseLayout>

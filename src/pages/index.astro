---
// Página provisional (paso 1): valida build, deploy y subpath. Se sustituye en el paso 3.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { url } from '../lib/url';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Ascension — Time to ascend</title>
	</head>
	<body>
		<main>
			<Image src={logo} alt="Logo de Ascension" width={240} loading="eager" />
			<h1>Ascension</h1>
			<p>Time to ascend</p>
			<p><a href={url('/')}>Inicio</a></p>
		</main>
	</body>
</html>

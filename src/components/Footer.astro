---
import { CONTACT_EMAIL } from '../config';
import { localePath, toLocale, useTranslations } from '../i18n';
import LangSwitch from './LangSwitch.astro';

interface Props {
	langSwitch?: boolean;
}

const { langSwitch = true } = Astro.props;
const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<p>
			<span class="site-footer__label">{t('footer.contact')}:</span>
			<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
		</p>
		<nav aria-label={t('footer.legalLabel')}>
			<ul class="site-footer__links" role="list">
				<li><a href={localePath(lang, '/privacy')}>{t('footer.privacy')}</a></li>
				<li><a href={localePath(lang, '/delete-account')}>{t('footer.deleteAccount')}</a></li>
			</ul>
		</nav>
		{langSwitch && <LangSwitch />}
		<p class="site-footer__copy">© {year} {t('footer.copyright')}</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-section);
		padding-block: var(--space-xl);
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
		color: var(--color-text-secondary);
		font-size: var(--text-sm);
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-xl);
		justify-content: space-between;
		align-items: center;
	}

	.site-footer a {
		color: var(--color-text);
	}

	.site-footer__label {
		margin-right: var(--space-3xs);
	}

	.site-footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-lg);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__links a {
		display: inline-block;
		padding-block: var(--space-3xs);
	}
</style>

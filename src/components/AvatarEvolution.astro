---
import { Image } from 'astro:assets';
import { AVATAR_STAGES } from '../data/avatar-stages';
import { es } from '../i18n/es';

const last = AVATAR_STAGES.length - 1;
---

<section id="evolucion" class="evolution" aria-labelledby="evolucion-title">
	<div class="container">
		<header class="section-head">
			<h2 id="evolucion-title">{es['evolution.title']}</h2>
			<p>{es['evolution.lead']}</p>
		</header>
	</div>

	<ol class="stages" tabindex="0" aria-label={es['evolution.listLabel']}>
		{
			AVATAR_STAGES.map((stage, i) => {
				const name = es[`evolution.${stage.id}`];
				const level = `${es['evolution.level']} ${stage.minLevel}${i === last ? '+' : ''}`;
				return (
					<li class:list={['stage', { 'stage--final': i === last }]}>
						<div class="stage__art">
							<Image
								src={stage.image}
								alt={`${es['evolution.alt']} ${name}`}
								width={180}
								densities={[1, 2]}
								loading="lazy"
							/>
						</div>
						<span class="level">{level}</span>
						<h3>{name}</h3>
					</li>
				);
			})
		}
	</ol>
</section>

<style>
	.evolution {
		padding-block: var(--space-section);
	}

	.stages {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 200px;
		gap: var(--space-md);
		margin: 0 auto;
		padding: var(--space-xl) var(--gutter) var(--space-lg);
		max-width: calc(var(--container) + 2 * var(--gutter));
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--gutter);
		overscroll-behavior-x: contain;
	}

	.stages:focus-visible {
		outline-offset: -3px;
	}

	.stage {
		position: relative;
		display: grid;
		justify-items: center;
		gap: var(--space-2xs);
		padding: var(--space-lg) var(--space-sm);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-bg);
		text-align: center;
		scroll-snap-align: start;
	}

	/* Conector entre etapas: la "pista de XP". */
	.stage:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 50%;
		right: calc(-1 * var(--space-md) - 1px);
		width: var(--space-md);
		height: 2px;
		background: linear-gradient(90deg, var(--color-border), var(--color-gold));
	}

	.stage__art {
		position: relative;
		width: 100%;
		max-width: 160px;
		aspect-ratio: 9 / 10;
	}

	.stage__art :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		/* Los PNG traen fondo blanco: multiply lo funde con la tarjeta. */
		mix-blend-mode: multiply;
	}

	.level {
		padding: 2px var(--space-xs);
		border-radius: var(--radius-pill);
		background: var(--color-text);
		color: var(--color-gold);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
	}

	.stage h3 {
		font-size: var(--text-lg);
	}

	.stage--final {
		border-color: var(--color-gold);
		box-shadow: var(--glow-gold);
		background: linear-gradient(180deg, var(--color-bg) 55%, var(--color-gold-light));
	}

	@media (min-width: 1100px) {
		.stages {
			grid-auto-flow: row;
			grid-template-columns: repeat(5, 1fr);
			overflow: visible;
		}
	}
</style>

---
import { Image } from 'astro:assets';
import { AVATAR_STAGES } from '../data/avatar-stages';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);

const last = AVATAR_STAGES.length - 1;
---

<section id="evolucion" class="evolution section--dark" aria-labelledby="evolucion-title">
	<div class="container">
		<header class="section-head">
			<p class="section-eyebrow">{t('evolution.eyebrow')}</p>
			<h2 id="evolucion-title">{t('evolution.title')}</h2>
			<p>{t('evolution.lead')}</p>
		</header>
	</div>

	<ol class="stages" tabindex="0" aria-label={t('evolution.listLabel')}>
		{
			AVATAR_STAGES.map((stage, i) => {
				const name = t(`evolution.${stage.id}`);
				const level = `${t('evolution.level')} ${stage.minLevel}${i === last ? '+' : ''}`;
				return (
					<li class:list={['stage', { 'stage--final': i === last }]} style={`--i: ${i}`}>
						<div class="stage__art">
							<Image
								src={stage.image}
								alt={`${t('evolution.alt')} ${name}`}
								width={180}
								densities={[1, 2]}
								loading="lazy"
							/>
						</div>
						<span class="level">{level}</span>
						<h3>{name}</h3>
					</li>
				);
			})
		}
	</ol>
</section>

<style>
	.evolution {
		position: relative;
		padding-block: var(--space-section);
		overflow: hidden;
	}

	/* Luz dorada muy tenue que sube desde la etapa final. */
	.evolution::before {
		content: '';
		position: absolute;
		inset: auto -20% -40% 20%;
		height: 80%;
		background: radial-gradient(closest-side, rgb(201 168 76 / 0.16), transparent 75%);
		pointer-events: none;
	}

	.evolution > * {
		position: relative;
	}

	.stages {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 200px;
		gap: var(--space-md);
		margin: 0 auto;
		padding: var(--space-xl) var(--gutter) var(--space-lg);
		max-width: calc(var(--container) + 2 * var(--gutter));
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--gutter);
		overscroll-behavior-x: contain;
	}

	.stages:focus-visible {
		outline-offset: -3px;
	}

	.stage {
		position: relative;
		display: grid;
		justify-items: center;
		gap: var(--space-2xs);
		padding: var(--space-lg) var(--space-sm);
		border: 1px solid transparent;
		border-radius: var(--radius-xl);
		background: var(--color-bg);
		color: var(--color-text);
		text-align: center;
		box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.5);
		scroll-snap-align: start;
	}

	/* Conector entre etapas: la "pista de XP". */
	.stage:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 50%;
		right: calc(-1 * var(--space-md) - 1px);
		width: var(--space-md);
		height: 2px;
		background: linear-gradient(90deg, var(--color-border-on-dark), var(--color-gold));
	}

	.stage__art {
		position: relative;
		width: 100%;
		max-width: 160px;
		aspect-ratio: 9 / 10;
	}

	.stage__art :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		/* Los PNG traen fondo blanco: multiply lo funde con la tarjeta. */
		mix-blend-mode: multiply;
	}

	.level {
		padding: 2px var(--space-xs);
		border-radius: var(--radius-pill);
		background: var(--color-text);
		color: var(--color-gold);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
	}

	.stage h3 {
		font-size: var(--text-lg);
	}

	.stage--final {
		border-color: var(--color-gold);
		background: linear-gradient(180deg, var(--color-bg) 55%, var(--color-gold-light));
	}

	/* El brillo va en una capa aparte para animar solo su opacidad (GPU), no el box-shadow. */
	.stage--final::before {
		content: '';
		position: absolute;
		inset: -1px;
		border-radius: inherit;
		box-shadow:
			0 0 0 1px rgb(201 168 76 / 0.6),
			0 0 48px rgb(201 168 76 / 0.35);
		pointer-events: none;
	}

	@keyframes glow-in {
		from {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			/* Las etapas viven en un contenedor con scroll horizontal: un view() propio se ataría a
			   él (que no se mueve en vertical). La lista declara la línea de tiempo y cada etapa
			   la usa con su tramo desplazado: Novato → … → Ascensión, en cascada. */
			.stages {
				view-timeline: --stages block;
			}

			.stage {
				animation: rise-in var(--ease-out) both;
				animation-timeline: --stages;
				animation-range: entry calc(10% + var(--i) * 7%) entry calc(60% + var(--i) * 7%);
			}

			/* La última etapa se "enciende" cuando termina la cascada: el clímax de la sección. */
			.stage--final::before {
				animation: glow-in var(--ease-out) both;
				animation-timeline: --stages;
				animation-range: entry 75% cover 45%;
			}
		}
	}

	@media (min-width: 1100px) {
		.stages {
			grid-auto-flow: row;
			grid-template-columns: repeat(5, 1fr);
			overflow: visible;
		}
	}
</style>

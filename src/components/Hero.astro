---
import { HERO_SCREENSHOT } from '../data/screenshots';
import { useTranslations } from '../i18n';
import Phone from './Phone.astro';
import PlayBadge from './PlayBadge.astro';

const t = useTranslations(Astro.currentLocale);
---

<section id="hero" class="hero" aria-labelledby="hero-title">
	<div class="container hero__inner">
		<div class="hero__copy">
			<p class="eyebrow enter" style="--i: 0">{t('hero.eyebrow')}</p>
			<h1 id="hero-title" class="enter" style="--i: 1"><span lang="en">{t('site.tagline')}</span></h1>
			<p class="hero__lead enter" style="--i: 2">{t('hero.lead')}</p>
			<PlayBadge eager class="enter" style="--i: 3" />
		</div>

		<div class="hero__visual enter" style="--i: 4">
			<div class="hero__glow" aria-hidden="true"></div>
			<Phone image={HERO_SCREENSHOT.image} alt={t('hero.screenshotAlt')} width={260} eager />
			<div class="xp-chip" aria-hidden="true">
				<span class="xp-chip__level">12</span>
				<span class="xp-chip__bar"><span></span></span>
				<span class="xp-chip__label">{t('hero.xpLabel')}</span>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-2xl) var(--space-section);
		overflow: hidden;
	}

	.hero__inner {
		display: grid;
		gap: var(--space-3xl);
		align-items: center;
		justify-items: center;
		text-align: center;
	}

	.hero__copy {
		display: grid;
		gap: var(--space-md);
		justify-items: center;
	}

	.eyebrow {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-gold-text);
	}

	.hero__lead {
		max-width: 34ch;
		font-size: var(--text-lg);
		color: var(--color-text-secondary);
	}

	.hero__visual {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
	}

	.hero__glow {
		position: absolute;
		inset: 10% 0;
		background: radial-gradient(closest-side, rgb(201 168 76 / 0.35), transparent);
		filter: blur(8px);
	}

	.hero__visual :global(.phone) {
		position: relative;
	}

	/* Insignia de nivel + barra de XP: guiño RPG decorativo. */
	.xp-chip {
		position: absolute;
		bottom: 12%;
		left: 50%;
		translate: -95% 0;
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		padding: var(--space-2xs) var(--space-sm) var(--space-2xs) var(--space-2xs);
		border-radius: var(--radius-pill);
		background: var(--color-bg);
		box-shadow: var(--shadow-card);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
	}

	.xp-chip__level {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--color-text);
		color: var(--color-gold);
		box-shadow: var(--glow-gold);
	}

	.xp-chip__bar {
		width: 88px;
		height: 8px;
		border-radius: var(--radius-pill);
		background: var(--color-border);
		overflow: hidden;
	}

	.xp-chip__bar span {
		display: block;
		width: 68%;
		height: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, var(--color-gold-light), var(--color-gold));
		transform-origin: left;
	}

	.xp-chip__label {
		color: var(--color-gold-text);
	}

	/* La barra de XP se llena cuando el móvil termina de entrar: el primer "progreso" que ve el
	   visitante. Decorativa y de una sola vez, así que puede durar más que la UI normal. */
	@keyframes xp-fill {
		from {
			transform: scaleX(0.04);
		}
	}

	@keyframes level-pop {
		50% {
			transform: scale(1.12);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.xp-chip__bar span {
			animation: xp-fill 1.2s var(--ease-out) 700ms both;
		}

		.xp-chip__level {
			animation: level-pop 360ms var(--ease-out) 1.7s both;
		}
	}

	@media (min-width: 900px) {
		.hero {
			padding-top: var(--space-section);
		}

		.hero__inner {
			grid-template-columns: 1.1fr 0.9fr;
			justify-items: start;
			text-align: left;
		}

		.hero__copy {
			justify-items: start;
		}

		.hero__visual {
			justify-items: center;
		}
	}
</style>

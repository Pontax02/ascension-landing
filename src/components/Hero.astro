---
import { HERO_SCREENSHOT } from '../data/screenshots';
import { useTranslations } from '../i18n';
import Phone from './Phone.astro';
import PlayBadge from './PlayBadge.astro';

const t = useTranslations(Astro.currentLocale);
const facts = [t('hero.facts.noAds'), t('hero.facts.noSubs'), t('hero.facts.langs')];
---

<section id="hero" class="hero" aria-labelledby="hero-title">
	<div class="container hero__inner">
		<div class="hero__copy">
			<p class="eyebrow enter" style="--i: 0">{t('hero.eyebrow')}</p>
			<h1 id="hero-title" class="enter" style="--i: 1"><span lang="en">{t('site.tagline')}</span></h1>
			<p class="hero__lead enter" style="--i: 2">{t('hero.lead')}</p>
			<PlayBadge eager class="enter" style="--i: 3" />
			<ul class="hero__facts enter" style="--i: 4" role="list" aria-label={t('hero.factsLabel')}>
				{
					facts.map((fact) => (
						<li>
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path d="M3.5 8.5 6.5 11.5 12.5 4.5" />
							</svg>
							{fact}
						</li>
					))
				}
			</ul>
		</div>

		<div class="hero__visual enter" style="--i: 4">
			<div class="hero__backdrop" aria-hidden="true">
				<svg class="hero__orbits" viewBox="0 0 400 400">
					<ellipse cx="200" cy="200" rx="190" ry="72" transform="rotate(-18 200 200)"></ellipse>
					<ellipse cx="200" cy="200" rx="150" ry="150"></ellipse>
				</svg>
			</div>
			<Phone image={HERO_SCREENSHOT.image} alt={t('hero.screenshotAlt')} width={260} eager />
			<div class="hero__chips" aria-hidden="true">
				<div class="float-chip float-chip--habit enter" style="--i: 6">
					<span class="float-chip__check">
						<svg viewBox="0 0 16 16"><path d="M3.5 8.5 6.5 11.5 12.5 4.5"></path></svg>
					</span>
					<span class="float-chip__text">{t('hero.chipHabit')}</span>
					<span class="float-chip__xp">{t('hero.chipXp')}</span>
				</div>
				<div class="float-chip float-chip--streak enter" style="--i: 7">
					<svg class="float-chip__flame" viewBox="0 0 16 16">
						<path d="M8 1.5c.4 2.2 3.5 3.6 3.5 7.1A3.5 3.5 0 0 1 8 12.1a3.5 3.5 0 0 1-3.5-3.5c0-1.6.8-2.6 1.6-3.3.2 1 .8 1.7 1.5 2 .1-2.2.4-4 .4-5.8Z"></path>
					</svg>
					<span class="float-chip__text">{t('hero.chipStreak')}</span>
				</div>
				<div class="xp-chip">
					<span class="xp-chip__level">12</span>
					<span class="xp-chip__bar"><span></span></span>
					<span class="xp-chip__label">{t('hero.xpLabel')}</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding-block: var(--space-2xl) var(--space-section);
		overflow: hidden;
	}

	/* Luz cálida de fondo, muy tenue: da profundidad sin competir con el contenido. */
	.hero::before {
		content: '';
		position: absolute;
		inset: -20% -10% auto auto;
		width: min(900px, 120vw);
		aspect-ratio: 1;
		background: radial-gradient(closest-side, rgb(201 168 76 / 0.16), transparent 70%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		display: grid;
		gap: var(--space-3xl);
		align-items: center;
	}

	.hero__copy {
		display: grid;
		gap: var(--space-md);
		justify-items: start;
	}

	.eyebrow {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-gold-text);
	}

	.hero__lead {
		max-width: 36ch;
		font-size: var(--text-lg);
		color: var(--color-text-secondary);
	}

	.hero__facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-md);
		margin: var(--space-2xs) 0 0;
		padding: var(--space-sm) 0 0;
		border-top: 1px solid var(--color-border);
		list-style: none;
		font-size: var(--text-sm);
		color: var(--color-text-secondary);
	}

	.hero__facts li {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.hero__facts svg {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: var(--color-gold-text);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.hero__visual {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		padding-block: var(--space-lg);
	}

	.hero__backdrop {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background: radial-gradient(closest-side, rgb(201 168 76 / 0.28), transparent 72%);
	}

	.hero__orbits {
		width: min(440px, 115%);
		fill: none;
		stroke: var(--color-gold);
		stroke-opacity: 0.35;
		stroke-width: 1;
	}

	.hero__orbits ellipse + ellipse {
		stroke: var(--color-border);
		stroke-opacity: 1;
		stroke-dasharray: 2 6;
	}

	.hero__visual :global(.phone) {
		position: relative;
	}

	.hero__chips {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.float-chip,
	.xp-chip {
		position: absolute;
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		padding: var(--space-2xs) var(--space-sm) var(--space-2xs) var(--space-2xs);
		border-radius: var(--radius-pill);
		background: rgb(255 255 255 / 0.92);
		backdrop-filter: blur(12px);
		box-shadow: var(--shadow-float), inset 0 0 0 1px rgb(29 29 31 / 0.06);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.8125rem;
		white-space: nowrap;
	}

	/* Anclados al móvil (260px de ancho, centrado) pero sin salirse del contenedor en 375px. */
	.float-chip--habit {
		top: 16%;
		right: max(0px, calc(50% - 190px));
	}

	.float-chip--streak {
		top: 46%;
		left: max(0px, calc(50% - 200px));
		padding-left: var(--space-xs);
	}

	.xp-chip {
		bottom: 14%;
		right: max(0px, calc(50% - 180px));
		font-weight: 700;
	}

	.float-chip__check {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: var(--color-success);
	}

	.float-chip__check svg {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: var(--color-bg);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.float-chip__xp {
		color: var(--color-gold-text);
		font-weight: 700;
	}

	.float-chip__flame {
		width: 16px;
		height: 16px;
		fill: var(--color-gold);
	}

	.xp-chip__level {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--color-text);
		color: var(--color-gold);
		box-shadow: 0 0 0 3px var(--color-gold-light);
	}

	.xp-chip__bar {
		width: 88px;
		height: 8px;
		border-radius: var(--radius-pill);
		background: var(--color-border);
		overflow: hidden;
	}

	.xp-chip__bar span {
		display: block;
		width: 68%;
		height: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, var(--color-gold-light), var(--color-gold));
		transform-origin: left;
	}

	.xp-chip__label {
		color: var(--color-gold-text);
	}

	/* La barra de XP se llena cuando el móvil termina de entrar: el primer "progreso" que ve el
	   visitante. Decorativa y de una sola vez, así que puede durar más que la UI normal. */
	@keyframes xp-fill {
		from {
			transform: scaleX(0.04);
		}
	}

	@keyframes level-pop {
		50% {
			transform: scale(1.12);
		}
	}

	/* Flotación mínima (4px) y lenta: el mockup "respira" sin distraer. Solo transform. */
	@keyframes float {
		50% {
			transform: translateY(-4px);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.xp-chip__bar span {
			animation: xp-fill 1.2s var(--ease-out) 700ms both;
		}

		.xp-chip__level {
			animation: level-pop 360ms var(--ease-out) 1.7s both;
		}

		.float-chip--habit {
			animation:
				rise-in var(--duration-enter) var(--ease-out) calc(var(--i) * 60ms) both,
				float 6s ease-in-out 1.2s infinite;
		}

		.float-chip--streak {
			animation:
				rise-in var(--duration-enter) var(--ease-out) calc(var(--i) * 60ms) both,
				float 7s ease-in-out 1.6s infinite;
		}
	}

	@media (min-width: 900px) {
		.hero {
			padding-top: var(--space-section);
		}

		.hero__inner {
			grid-template-columns: 1.1fr 0.9fr;
		}
	}
</style>

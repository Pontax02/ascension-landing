---
import { Image } from 'astro:assets';
import logo from '../assets/logo-mark.png';
import { localePath, toLocale, useTranslations } from '../i18n';
import LangSwitch from './LangSwitch.astro';

interface Props {
	langSwitch?: boolean;
}

const { langSwitch = true } = Astro.props;
const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href={localePath(lang, '/')} aria-label={t('a11y.home')}>
			<Image src={logo} alt="" width={32} densities={[1, 2, 3]} loading="eager" />
			<span class="brand__name" translate="no">{t('site.name')}</span>
		</a>
		{langSwitch && <LangSwitch />}
	</div>
</header>

<style>
	/* Material translúcido (guía de Apple): el contenido pasa por debajo, desenfocado, en vez de
	   una franja opaca que ocupa sitio. */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgb(245 245 247 / 0.8);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		backdrop-filter: blur(20px) saturate(180%);
		/* Se queda quieto en las View Transitions entre páginas: solo cambia el contenido. */
		view-transition-name: site-header;
	}

	/* Separador: una línea fina (hairline), como la sub-nav esmerilada de Apple. En capa aparte
	   para animar solo su opacidad al empezar el scroll. */
	.site-header::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: var(--hairline);
		pointer-events: none;
	}

	/* "Reducir transparencia": material opaco, sin desenfoque. */
	@media (prefers-reduced-transparency: reduce) {
		.site-header {
			background: var(--color-bg);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}
	}

	/* "Más contraste": borde definido en vez del degradado. */
	@media (prefers-contrast: more) {
		.site-header {
			background: var(--color-bg);
			border-bottom: 1px solid var(--color-divider);
		}
	}

	@keyframes header-raise {
		from {
			opacity: 0;
		}
	}

	/* Arriba del todo el header se funde con el hero; al bajar 80px aparece el borde.
	   Ligado al scroll: sin soporte o con "reducir movimiento", el borde se ve siempre. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.site-header::after {
				animation: header-raise var(--ease-linear) both;
				animation-timeline: scroll(root);
				animation-range: 0 80px;
			}
		}
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		min-height: 56px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		padding-block: var(--space-2xs);
		text-decoration: none;
	}

	/* El logo gira un poco al pasar el ratón: una señal pequeña de que lleva al inicio. */
	.brand :global(img) {
		transition: rotate var(--duration-hover) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.brand:hover :global(img) {
			rotate: -8deg;
		}
	}

	.brand__name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		letter-spacing: var(--tracking-wordmark);
		text-transform: uppercase;
	}
</style>

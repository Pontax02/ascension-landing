---
import { Image } from 'astro:assets';
import logo from '../assets/logo-mark.png';
import { localePath, toLocale, useTranslations } from '../i18n';
import LangSwitch from './LangSwitch.astro';

interface Props {
	langSwitch?: boolean;
}

const { langSwitch = true } = Astro.props;
const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href={localePath(lang, '/')} aria-label={t('a11y.home')}>
			<Image src={logo} alt="" width={32} densities={[1, 2, 3]} loading="eager" />
			<span class="brand__name">{t('site.name')}</span>
		</a>
		{langSwitch && <LangSwitch />}
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgb(255 255 255 / 0.92);
		backdrop-filter: saturate(180%) blur(16px);
		/* Se queda quieto en las View Transitions entre páginas: solo cambia el contenido. */
		view-transition-name: site-header;
	}

	/* Borde + sombra en una capa aparte: así se anima solo su opacidad. */
	.site-header::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: var(--color-border);
		box-shadow: 0 8px 24px -8px rgb(29 29 31 / 0.14);
		pointer-events: none;
	}

	@keyframes header-raise {
		from {
			opacity: 0;
		}
	}

	/* Arriba del todo el header se funde con el hero; al bajar 80px aparece el borde.
	   Ligado al scroll: sin soporte o con "reducir movimiento", el borde se ve siempre. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.site-header::after {
				animation: header-raise var(--ease-linear) both;
				animation-timeline: scroll(root);
				animation-range: 0 80px;
			}
		}
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		min-height: 56px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		padding-block: var(--space-2xs);
		text-decoration: none;
	}

	.brand__name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		letter-spacing: var(--tracking-wordmark);
		text-transform: uppercase;
	}
</style>

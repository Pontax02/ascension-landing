---
// Selector de idioma sin JavaScript: enlaces a la misma página en cada idioma.
import { LOCALES, switchLocalePath, useTranslations } from '../i18n';

const current = Astro.currentLocale;
const t = useTranslations(current);
---

<nav class="lang-switch" aria-label={t('lang.label')}>
	<ul role="list">
		{
			LOCALES.map((lang) => (
				<li>
					{lang === current ? (
						<span aria-current="page" lang={lang}>
							{t(`lang.${lang}`)}
						</span>
					) : (
						<a class="pressable" href={switchLocalePath(Astro.url.pathname, lang)} hreflang={lang} lang={lang}>
							{t(`lang.${lang}`)}
						</a>
					)}
				</li>
			))
		}
	</ul>
</nav>

<style>
	.lang-switch ul {
		display: flex;
		gap: var(--space-3xs);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.lang-switch a,
	.lang-switch span {
		position: relative;
		display: inline-block;
		padding: var(--space-3xs) var(--space-xs);
		border-radius: var(--radius-pill);
		font-size: var(--text-sm);
		line-height: 1.4;
	}

	.lang-switch span {
		background: var(--color-text);
		color: var(--color-bg);
		font-weight: 600;
	}

	.lang-switch a {
		color: var(--color-text);
		text-decoration: none;
	}

	/* La píldora se ve de 28px, pero el dedo necesita 44 (DESIGN.md): una capa invisible amplía
	   el área táctil en vertical sin cambiar el diseño. */
	.lang-switch a::before {
		content: '';
		position: absolute;
		inset: 50% 0 auto;
		min-height: 44px;
		translate: 0 -50%;
	}

	.lang-switch a:hover {
		background: var(--color-border);
	}
</style>

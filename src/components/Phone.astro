---
// Mockup de móvil en CSS: marco negro redondeado con la captura dentro (proporción 9:20).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	alt: string;
	width?: number;
	eager?: boolean;
	sizes?: string;
}

const { image, alt, width = 280, eager = false, sizes } = Astro.props;
---

<div class="phone" style={`--phone-w: ${width}px`}>
	<Image
		src={image}
		alt={alt}
		widths={[width, width * 2]}
		sizes={sizes ?? `${width}px`}
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : undefined}
	/>
</div>

<style>
	.phone {
		width: min(100%, var(--phone-w));
		aspect-ratio: 9 / 20;
		padding: 3.2%;
		border-radius: calc(var(--phone-w) * 0.14);
		background: var(--color-text);
		box-shadow:
			inset 0 0 0 2px #3a3a3e,
			0 24px 48px rgb(0 0 0 / 0.18),
			0 4px 12px rgb(0 0 0 / 0.08);
	}

	.phone :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: calc(var(--phone-w) * 0.11);
	}
</style>

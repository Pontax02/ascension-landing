---
// Con la app publicada (PLAY_STORE_URL != null): badge oficial de Google Play en el idioma de la
// página, sin modificar (guías de marca de Google). Mientras no lo esté: aviso propio
// "Próximamente en Google Play", sin el badge oficial (que dice "Disponible en") y sin enlace.
import { Image } from 'astro:assets';
import badgeEn from '../assets/badges/google-play-en.png';
import badgeEs from '../assets/badges/google-play-es.png';
import { PLAY_STORE_URL } from '../config';
import { useTranslations } from '../i18n';

interface Props {
	eager?: boolean;
	class?: string;
	style?: string;
}

const { eager = false, class: className, style } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const badge = Astro.currentLocale === 'en' ? badgeEn : badgeEs;
---

<div class:list={['play', className]} style={style}>
	{
		PLAY_STORE_URL ? (
			<a class="play-badge play-badge--live pressable" href={PLAY_STORE_URL}>
				<Image
					src={badge}
					alt={t('play.altLive')}
					width={180}
					densities={[1, 2]}
					loading={eager ? 'eager' : 'lazy'}
				/>
			</a>
		) : (
			<p class="play-badge play-badge--soon">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<rect x="6" y="2" width="12" height="20" rx="3" />
					<path d="M11 18h2" />
				</svg>
				<span>{t('play.comingSoon')}</span>
			</p>
		)
	}
	<p class="play__note">{t('play.freeToStart')}</p>
</div>

<style>
	.play {
		display: grid;
		justify-items: inherit;
		gap: var(--space-2xs);
	}

	/* El badge oficial no se modifica: solo sube 2px en hover y se hunde al pulsar (.pressable). */
	.play-badge--live {
		display: inline-block;
		transition:
			transform var(--duration-press) var(--ease-out),
			translate var(--duration-hover) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.play-badge--live:hover {
			translate: 0 -2px;
		}
	}

	.play-badge--live :global(img) {
		/* El PNG oficial trae margen transparente; se compensa para alinear con el texto. */
		margin-inline: -11px;
	}

	.play-badge--soon {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		margin: 0;
		padding: var(--space-xs) var(--space-lg) var(--space-xs) var(--space-md);
		border: 1px solid var(--color-gold);
		border-radius: var(--radius-pill);
		background: var(--color-text);
		color: var(--color-bg);
		font-family: var(--font-display);
		font-weight: 600;
	}

	.play-badge--soon svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: var(--color-gold);
		stroke-width: 1.8;
		stroke-linecap: round;
	}

	.play__note {
		font-size: var(--text-sm);
		color: var(--color-text-secondary);
	}
</style>

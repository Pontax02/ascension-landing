---
import { Image } from 'astro:assets';
import mark from '../assets/logo-mark.png';
import { useTranslations } from '../i18n';
import PlayBadge from './PlayBadge.astro';

const t = useTranslations(Astro.currentLocale);
---

<section id="cta" class="cta" aria-labelledby="cta-title">
	<div class="container cta__inner">
		<div class="cta__mark reveal" style="--i: 0">
			<Image src={mark} alt="" width={72} densities={[1, 2]} loading="lazy" />
		</div>
		<h2 id="cta-title" class="reveal" style="--i: 1"><span lang="en">{t('site.tagline')}</span></h2>
		<p class="cta__lead reveal" style="--i: 2">{t('cta.lead')}</p>
		<PlayBadge class="reveal" style="--i: 3" />
	</div>
</section>

<style>
	.cta {
		padding-block: var(--space-section) 0;
	}

	.cta__inner {
		display: grid;
		justify-items: center;
		gap: var(--space-md);
		text-align: center;
	}

	.cta__mark {
		display: grid;
		place-items: center;
		width: 112px;
		height: 112px;
		border-radius: 50%;
		background: radial-gradient(closest-side, var(--color-gold-light), transparent);
	}

	.cta h2 {
		font-size: var(--text-display);
	}

	.cta__lead {
		font-size: var(--text-lg);
		color: var(--color-text-secondary);
	}
</style>

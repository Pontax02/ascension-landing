---
// Bento asimétrico: el árbol de hábitos (lo que hace distinta a la app) ocupa dos filas.
// Cada tarjeta muestra una miniatura de la interfaz (decorativa) además del texto.
import { Image } from 'astro:assets';
import avatar2 from '../assets/avatars/avatar_2.png';
import avatar3 from '../assets/avatars/avatar_3.png';
import avatar5 from '../assets/avatars/avatar_5.png';
import { toLocale, useTranslations } from '../i18n';

const lang = toLocale(Astro.currentLocale);
const t = useTranslations(lang);
const num = new Intl.NumberFormat(lang === 'en' ? 'en-US' : 'es-ES');

// Nivel 12 → 13 cuesta 12 × 500 XP en la app (Nivel.java).
const xp = { current: 3240, next: 6000 };
// Niveles coherentes con la etapa de cada avatar (avatar_nivel.dart).
const friends = [
	{ image: avatar2, level: 7 },
	{ image: avatar3, level: 14 },
	{ image: avatar5, level: 38 },
];
---

<section id="pilares" class="pillars" aria-labelledby="pilares-title">
	<div class="container">
		<header class="section-head section-head--start">
			<p class="section-eyebrow">{t('pillars.eyebrow')}</p>
			<h2 id="pilares-title">{t('pillars.title')}</h2>
			<p>{t('pillars.lead')}</p>
		</header>

		<ul class="bento" role="list">
			<li class="pillar pillar--feature reveal" style="--i: 0">
				<div class="pillar__visual pillar__visual--tree" aria-hidden="true">
					<svg class="tree" viewBox="0 0 280 210">
						<g class="tree__links">
							<path pathLength="1" d="M140 190 V150 L80 118"></path>
							<path pathLength="1" d="M140 150 L200 118"></path>
							<path pathLength="1" d="M80 118 L50 66"></path>
							<path pathLength="1" d="M80 118 L110 66"></path>
							<path pathLength="1" d="M200 118 L200 66"></path>
							<path pathLength="1" class="tree__link--locked" d="M110 66 L110 20"></path>
						</g>
						<circle class="node node--done" cx="140" cy="190" r="12"></circle>
						<circle class="node node--done" cx="80" cy="118" r="11"></circle>
						<circle class="node node--done" cx="200" cy="118" r="11"></circle>
						<circle class="node node--done" cx="50" cy="66" r="10"></circle>
						<circle class="node node--open" cx="110" cy="66" r="10"></circle>
						<circle class="node node--locked" cx="200" cy="66" r="10"></circle>
						<circle class="node node--locked" cx="110" cy="20" r="9"></circle>
					</svg>
				</div>
				<div class="pillar__text">
					<span class="pillar__icon">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="20" r="2"></circle>
							<circle cx="6" cy="11" r="2"></circle>
							<circle cx="18" cy="11" r="2"></circle>
							<path d="M12 18v-3l-6-2m6 2 6-2"></path>
						</svg>
					</span>
					<h3>{t('pillars.tree.title')}</h3>
					<p>{t('pillars.tree.body')}</p>
				</div>
			</li>

			<li class="pillar reveal" style="--i: 1">
				<div class="pillar__visual pillar__visual--xp" aria-hidden="true">
					<span class="lvl">{t('pillars.levelShort')} 12</span>
					<div class="xp">
						<span class="xp__bar"><span style={`width: ${(xp.current / xp.next) * 100}%`}></span></span>
						<span class="xp__nums">{num.format(xp.current)} / {num.format(xp.next)} XP</span>
					</div>
				</div>
				<div class="pillar__text">
					<span class="pillar__icon">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="m12 3 2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 15.4l-4.8 2.5.9-5.4-3.9-3.8 5.4-.8Z"></path>
						</svg>
					</span>
					<h3>{t('pillars.rpg.title')}</h3>
					<p>{t('pillars.rpg.body')}</p>
				</div>
			</li>

			<li class="pillar reveal" style="--i: 2">
				<div class="pillar__visual pillar__visual--friends" aria-hidden="true">
					<ul class="faces" role="list">
						{
							friends.map((f, n) => (
								<li style={`--n: ${n}`}>
									<Image src={f.image} alt="" width={48} densities={[1, 2]} loading="lazy" />
									<span>{f.level}</span>
								</li>
							))
						}
					</ul>
					<span class="code"><span>{t('pillars.inviteCode')}</span><b translate="no">7KQ4MX2P</b></span>
				</div>
				<div class="pillar__text">
					<span class="pillar__icon">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="9" cy="8" r="3.5"></circle>
							<circle cx="17" cy="9" r="2.5"></circle>
							<path d="M2.5 20c.6-3.6 3.2-6 6.5-6s5.9 2.4 6.5 6M15 14.2c.6-.1 1.3-.2 2-.2 2.6 0 4.4 2 4.8 5"></path>
						</svg>
					</span>
					<h3>{t('pillars.friends.title')}</h3>
					<p>{t('pillars.friends.body')}</p>
				</div>
			</li>
		</ul>
	</div>
</section>

<style>
	.pillars {
		padding-block: var(--space-section);
		background: var(--color-surface);
	}

	.bento {
		display: grid;
		gap: var(--space-md);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pillar {
		display: grid;
		grid-template-rows: auto auto;
		gap: var(--space-lg);
		align-content: start;
		padding: var(--space-lg);
		position: relative;
		border-radius: var(--radius-card);
		background: var(--color-bg);
		box-shadow: inset 0 0 0 1px var(--hairline);
		transition: translate var(--duration-hover) var(--ease-out);
	}

	/* Borde más marcado en hover, en su propia capa: solo cambia su opacidad. Sin sombra de
	   elevación (DESIGN.md: las tarjetas no llevan sombra). */
	.pillar::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.16);
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--duration-hover) ease;
	}

	.pillar__text {
		display: grid;
		gap: var(--space-xs);
	}

	.pillar__text p {
		max-width: 46ch;
		color: var(--color-text-secondary);
	}

	.pillar__icon {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		margin-bottom: var(--space-3xs);
		border-radius: var(--radius-md);
		background: var(--color-text);
		transition:
			rotate var(--duration-hover) var(--ease-out),
			scale var(--duration-hover) var(--ease-out);
	}

	.pillar__icon svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: var(--color-gold);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* ── Miniaturas ─────────────────────────────────────────── */
	.pillar__visual {
		display: grid;
		place-items: center;
		min-height: 150px;
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}

	.pillar__visual--tree {
		min-height: 240px;
	}

	.tree {
		width: min(100%, 300px);
		overflow: visible;
	}

	.tree__links path {
		fill: none;
		stroke: var(--color-gold);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.tree__links .tree__link--locked {
		stroke: var(--color-divider);
		stroke-dasharray: 0.04 0.06;
	}

	.node {
		stroke-width: 2;
	}

	.node--done {
		fill: var(--color-gold);
		stroke: var(--color-bg);
	}

	.node--open {
		fill: var(--color-bg);
		stroke: var(--color-text);
	}

	.node--locked {
		fill: var(--color-surface);
		stroke: var(--color-divider);
		stroke-dasharray: 3 3;
	}

	.pillar__visual--xp {
		grid-template-columns: auto 1fr;
		gap: var(--space-sm);
		padding: var(--space-lg);
	}

	.lvl {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--color-text);
		color: var(--color-gold);
		font-family: var(--font-display);
		font-weight: 700;
		box-shadow: 0 0 0 4px var(--color-gold-light);
	}

	.xp {
		display: grid;
		gap: 6px;
		width: 100%;
	}

	.xp__bar {
		height: 10px;
		border-radius: var(--radius-pill);
		background: var(--color-border);
		overflow: hidden;
	}

	.xp__bar span {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--color-gold);
		transform-origin: left;
	}

	.xp__nums {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-sm);
		font-variant-numeric: tabular-nums;
		color: var(--color-text-secondary);
	}

	.pillar__visual--friends {
		gap: var(--space-sm);
		padding: var(--space-lg);
	}

	.faces {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.faces li {
		position: relative;
		width: 56px;
		height: 56px;
		margin-left: -10px;
		border-radius: 50%;
		background: var(--color-bg);
		box-shadow: 0 0 0 3px var(--color-surface);
		overflow: visible;
	}

	.faces li:first-child {
		margin-left: 0;
	}

	.faces :global(img) {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		object-position: 50% 12%;
		mix-blend-mode: multiply;
	}

	/* Centrada abajo: la cara siguiente solapa el borde derecho, no el centro. */
	.faces span {
		position: absolute;
		left: 50%;
		bottom: -8px;
		translate: -50% 0;
		box-shadow: 0 0 0 2px var(--color-surface);
		padding: 0 6px;
		border-radius: var(--radius-pill);
		background: var(--color-text);
		color: var(--color-gold);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.6875rem;
		line-height: 18px;
	}

	.code {
		display: grid;
		justify-items: center;
		gap: 6px;
		margin-top: var(--space-2xs);
		font-size: 0.75rem;
		color: var(--color-text-secondary);
	}

	.code b {
		padding: 4px var(--space-sm);
		border-radius: var(--radius-pill);
		background: var(--color-bg);
		box-shadow: inset 0 0 0 1px var(--color-border);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.14em;
		color: var(--color-text);
	}

	@media (min-width: 768px) {
		.bento {
			grid-template-columns: 1.25fr 1fr;
		}

		.pillar {
			padding: var(--space-xl);
		}

		/* La destacada ocupa dos filas: su miniatura crece para llenar la altura. */
		.pillar--feature {
			grid-row: span 2;
			grid-template-rows: 1fr auto;
		}

		.pillar--feature .tree {
			width: min(100%, 380px);
		}
	}

	/* ── Hover (solo con ratón): la tarjeta sube 4px, se marca su borde y el icono "saluda".
	   Con `translate`/`rotate`/`scale` sueltos, no con `transform`: el revelado al hacer scroll
	   ya anima `transform` con fill: both y lo pisaría. Sin movimiento con "reducir movimiento";
	   el borde (no mueve nada) se mantiene. ── */
	@media (hover: hover) and (pointer: fine) {
		.pillar:hover::after {
			opacity: 1;
		}
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.pillar:hover {
			translate: 0 var(--lift);
		}

		.pillar:hover .pillar__icon {
			rotate: -8deg;
			scale: 1.08;
		}
	}

	/* ── Movimiento: el árbol se dibuja y la barra se llena al entrar en pantalla ── */
	@keyframes draw {
		from {
			stroke-dashoffset: 1;
		}
	}

	@keyframes node-in {
		from {
			opacity: 0;
			transform: scale(0.6);
		}
	}

	@keyframes face-in {
		from {
			opacity: 0;
			transform: scale(0.9);
		}
	}

	@keyframes fill {
		from {
			transform: scaleX(0.05);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.tree__links path:not(.tree__link--locked) {
				stroke-dasharray: 1;
				animation: draw var(--ease-out) both;
				animation-timeline: view();
				animation-range: entry 30% cover 45%;
			}

			.node {
				transform-box: fill-box;
				transform-origin: center;
				animation: node-in var(--ease-out) both;
				animation-timeline: view();
				animation-range: entry 40% cover 45%;
			}

			.xp__bar span {
				animation: fill var(--ease-out) both;
				animation-timeline: view();
				animation-range: entry 40% cover 50%;
			}

			/* Las caras de los amigos llegan una a una (desde 0.9, nunca desde 0). */
			.faces {
				view-timeline: --faces block;
			}

			.faces li {
				animation: face-in var(--ease-out) both;
				animation-timeline: --faces;
				animation-range: entry calc(40% + var(--n) * 12%) cover calc(40% + var(--n) * 6%);
			}
		}
	}
</style>
